# Copy this file to `.env` in this folder. Never commit your real `.env`.
#
#   cp .env.sample .env
#
# Then replace the placeholder API key. Chat and embeddings share the same key.

# OpenAI-compatible LLM (Mistral shown here)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=replace-with-your-mistral-api-key
LLM_MODEL=open-mistral-nemo

# Embeddings (mistral-embed uses LLM_API_KEY)
EMBEDDING_MODEL=mistral-embed

# Local storage (paths are relative to the appsense/ folder)
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/appsense.db
UPLOADS_PATH=./data/uploads
REPOS_PATH=./data/repos
# Commands use the AppSense folder unless a command sets its own working directory.
DEFAULT_COMMAND_CWD=.
# Python used for commands beginning with `python` or `python3`; defaults to the active AppSense interpreter.
# DEFAULT_COMMAND_PYTHON=/absolute/path/to/appsense/backend/.venv/bin/python
# Supported application runtime (replace these with the separate app's paths).
# TARGET_APP_ROOT=/absolute/path/to/DataPro AI
# TARGET_APP_PYTHON=/absolute/path/to/DataPro AI/.venv/bin/python
# TARGET_APP_ENV_FILE=/absolute/path/to/DataPro AI/.env
