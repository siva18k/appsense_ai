# Copy to .env in this folder (appsense/.env). Never commit .env.

# Mistral (OpenAI-compatible). Same key is used for chat and embeddings.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=open-mistral-nemo
EMBEDDING_MODEL=mistral-embed

# Local storage (relative to the appsense/ folder)
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/appsense.db
UPLOADS_PATH=./data/uploads
REPOS_PATH=./data/repos
